API_URL_ANDROID=https://iftek7500.ilmifygroup.com/api/v1
API_URL_IOS=https://iftek7500.ilmifygroup.com/api/v1

# --- Social sign-in OAuth clients -------------------------------------------
# Google: the *web* client id is what both platforms send to the backend as the
# ID token audience; the iOS client id is additionally required by the iOS SDK.
GOOGLE_WEB_CLIENT_ID=58690558184-kmcjo2buchsa2058o5ndojtrn9v3711r.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=58690558184-jj9sm9r3io9rruub7l4ubnumeatmni16.apps.googleusercontent.com

# Facebook: must also be mirrored into android/app/src/main/res/values/strings.xml
# and ios/GameApp/Info.plist - the native SDKs read them from there, not from here.
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
