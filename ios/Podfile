# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

$RNFirebaseDisableSPM = true

# Warnings inside third-party pods (React Native, Firebase, Stripe, ...) are not
# ours to fix and bury the app's own warnings, so they are silenced. The app
# target's warnings are unaffected.
inhibit_all_warnings!

# Script phases that declare no outputs make Xcode warn that they "will be run
# during every build". Running every build is what these need, so say so.
def run_script_phases_every_build(targets)
  targets.each do |target|
    target.shell_script_build_phases.each do |phase|
      next unless Array(phase.output_paths).empty? && Array(phase.output_file_list_paths).empty?
      phase.always_out_of_date = '1'
    end
  end
end

target 'Cheer Madness' do
  config = use_native_modules!

  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        # Pods compile some files that end up empty on this platform; libtool
        # warns once per file. Nothing is wrong, so it is told not to.
        cfg.build_settings['OTHER_LIBTOOLFLAGS'] = '$(inherited) -no_warning_for_no_symbols'
      end
    end
    run_script_phases_every_build(installer.pods_project.targets)
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        target.build_configurations.each do |cfg|
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end

  # The app project's phases ([RNFB] Core Configuration is added by a pod) are
  # written during integration, after post_install, so they are fixed here.
  post_integrate do |installer|
    installer.aggregate_targets.map(&:user_project).uniq.each do |project|
      run_script_phases_every_build(project.native_targets)
      project.save
    end
  end
end
