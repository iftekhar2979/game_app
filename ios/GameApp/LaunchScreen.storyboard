<?xml version="1.0" encoding="UTF-8"?>
<!--
  The launch screen is the CheerBattle splash artwork, full bleed.

  Pinned to the view's edges rather than the safe area, and scaled
  `scaleAspectFill`, so it reaches under the status bar and home indicator on
  every device. Aspect fill crops rather than letterboxes: the art is 852x1846,
  and the alternative (`scaleAspectFit`) would leave bars on taller and shorter
  handsets. The backing colour stays black so any sliver during rotation or on
  an unusual aspect matches the artwork's own edges.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="15702" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="15704"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashScreen" translatesAutoresizingMaskIntoConstraints="NO" id="SpL-1m-g0a">
                                <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="SpL-1m-g0a" firstAttribute="top" secondItem="Ze5-6b-2t3" secondAttribute="top" id="spl-t0-p01"/>
                            <constraint firstItem="SpL-1m-g0a" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="spl-l0-e02"/>
                            <constraint firstAttribute="trailing" secondItem="SpL-1m-g0a" secondAttribute="trailing" id="spl-t1-r03"/>
                            <constraint firstAttribute="bottom" secondItem="SpL-1m-g0a" secondAttribute="bottom" id="spl-b0-t04"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52.173913043478265" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="SplashScreen" width="852" height="1846"/>
    </resources>
</document>
