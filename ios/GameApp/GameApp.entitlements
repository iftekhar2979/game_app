<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sign in with Apple + Push Notifications. This file is now linked via
	  CODE_SIGN_ENTITLEMENTS, but the entitlements themselves are only
	  authorised once both capabilities are enabled on the App ID in your
	  Apple Developer account (Certificates, Identifiers & Profiles, or via
	  Xcode's Signing & Capabilities tab with a team selected, which syncs it
	  for you). Without that, code signing will fail for a real device build.

	  aps-environment is "development" here; Xcode rewrites it to
	  "production" automatically when archiving for release with a
	  distribution profile.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
